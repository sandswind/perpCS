# Copy to contracts/.env and fill in.

# RPC URLs (use a private endpoint; public ones rate-limit hard)
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer private key (0x-prefixed). Use a throwaway key — this is testnet only.
PRIVATE_KEY=0x...

# Etherscan / Arbiscan API keys for verify (optional)
ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=

# Vault recipients for the 100B USDR initial supply.
# Defaults below mint into the deployer for development; in production set
# distinct addresses (e.g. multisigs) before running the deploy script.
USDR_VAULT_FAUCET=0x0000000000000000000000000000000000000000
USDR_VAULT_INSURANCE=0x0000000000000000000000000000000000000000
USDR_VAULT_TREASURY=0x0000000000000000000000000000000000000000
USDR_VAULT_TEAM=0x0000000000000000000000000000000000000000
USDR_VAULT_LIQUIDITY=0x0000000000000000000000000000000000000000

# How much of the Faucet vault is delegated to USDRFaucet contract on deploy.
# Default = entire 60B faucet vault.
FAUCET_FUNDING_USDR=60000000000
