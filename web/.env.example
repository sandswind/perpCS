# Copy to web/.env.local and fill in.

# Backend HTTP base (no trailing slash). Defaults to http://localhost:8080.
NEXT_PUBLIC_API_BASE=http://localhost:8080

# Backend WS base. Defaults to ws://localhost:8080.
NEXT_PUBLIC_WS_BASE=ws://localhost:8080

# WalletConnect cloud projectId. Get one at https://cloud.walletconnect.com
# (free for hobby/dev use). Without a real id, only injected wallets like
# MetaMask work — WC QR pairing will fail.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
